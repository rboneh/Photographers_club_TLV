<%- include('../partials/header') %>

    <!-- ===== Page ===== -->
    <div class="d-flex flex-column min-vh-100">

        <main class="flex-grow-1">
            <div class="container-fluid py-5">

                <% if (locals.exhibitionObj && locals.exhibitionKey) { %>
                    <% const exhibitionName=locals.exhibitionObj.exhibitionName; %>
                        <% const exhibitionAbout=locals.exhibitionObj.exhibitionAbout; %>

                                <div class="container py-5 d-flex flex-column justify-content-center mt-4">
                                    <h1 class="mb-4 text-center">מועדון צילום תל אביב</h1>
                                    <h2 class="mb-4 text-center">
                                        <%= exhibitionName %>
                                    </h2>
                                    <div class="h4 text-center mx-4">
                                        <%- exhibitionAbout %>
                                    </div>

                                </div>



                                <!-- exhibition pictures grid per member -->
                                <% exhibitionObj.membersArr.forEach(member=> { %>

                                    <div class="container-fluid py-4">
                                        <div class="container py-3">
                                            <h3 class="mb-3 text-center handwriting-hebrew">
                                                <%= member.name %>
                                            </h3>

                                            <% if (member.about) { %>
                                                <p class="h4 text-center pb-4 opacity-75">
                                                    <%- member.about %>
                                                </p>
                                                <% } %>

                                                    <div class="masonry-wrapper" dir="ltr">
                                                        <div class="masonry <%= member.photos.length <= 3 ? 'few' : 'many' %>">
                                                            <% member.photos.forEach(photo=> { %>
                                                                <div class="masonry-item">
                                                                    <button type="button"
                                                                        class="btn p-0 border-0 rb-thumb"
                                                                        data-member-name="<%= member.name %>"
                                                                        data-member-about="<%= member.about || '' %>"
                                                                        data-img-src="<%= photo.picture %>"
                                                                        aria-label="צילום מאת <%= member.name %>">

                                                                        <img src="<%= photo.picture %>"
                                                                            class="img-fluid rounded shadow-sm"
                                                                            loading="lazy"
                                                                            alt="צילום מאת <%= member.name %>">
                                                                    </button>
                                                                </div>
                                                                <% }) %>
                                                        </div>
                                                    </div>

                                        </div>
                                    </div>


                                    <hr class="border-secondary opacity-25 my-4">

                                    <% }) %>

            </div>

            <!-- ✅ JSON-LD schema (Google) -->
            <script type="application/ld+json">
                                    <%- JSON.stringify({
                                    "@context": "https://schema.org",
                                    "@type": "ExhibitionEvent",
                                    name: exhibitionName,
                                    description: exhibitionAbout,
                                    organizer: { "@type": "Organization", name: "מועדון הצילום תל אביב" }
                                    }) %>
                                    </script>

            <% } else { %>
                <h1 class="text-center">מועדון צילום תל אביב</h1>
                <h2 class="text-center">התערוכה לא נמצאה.</h2>
                <% } %>

    </div>
    </main>

    <%- include('../partials/footer') %>
        </div>



        <div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered rb-modal-90">
                <div class="modal-content bg-dark">
                    <button type="button" class="btn-close btn-close-white ms-auto m-2" data-bs-dismiss="modal"
                        aria-label="Close"></button>

                    <div class="modal-body p-0 d-flex justify-content-center align-items-center">
                        <button type="button" id="modalPrev" class="rb-photo-nav rb-photo-prev"
                            aria-label="הצילום הקודם" aria-controls="modalImg" hidden>
                            <span aria-hidden="true">&#10094;</span>
                        </button>
                        <img id="modalImg" class="img-fluid" alt="">
                        <button type="button" id="modalNext" class="rb-photo-nav rb-photo-next"
                            aria-label="הצילום הבא" aria-controls="modalImg" hidden>
                            <span aria-hidden="true">&#10095;</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>



        <script>
            const modalImg = document.getElementById("modalImg");
            const modalEl = document.getElementById("photoModal");
            const photoModal = modalEl ? new bootstrap.Modal(modalEl) : null;
            const modalPrev = document.getElementById("modalPrev");
            const modalNext = document.getElementById("modalNext");
            let seriesButtons = [];
            let currentPhotoIndex = 0;

            function setModalFromBtn(btn) {
                const src = btn?.dataset?.imgSrc;
                if (modalImg && src) {
                    modalImg.src = src;
                    modalImg.alt = btn.dataset.memberName ? `צילום מאת ${btn.dataset.memberName}` : "";
                }
            }

            function showPhoto(index) {
                if (!seriesButtons.length) return;
                currentPhotoIndex = (index + seriesButtons.length) % seriesButtons.length;
                document.querySelectorAll(".rb-thumb.active").forEach(btn => btn.classList.remove("active"));
                const btn = seriesButtons[currentPhotoIndex];
                btn.classList.add("active");
                setModalFromBtn(btn);
            }

            modalPrev.addEventListener("click", () => showPhoto(currentPhotoIndex - 1));
            modalNext.addEventListener("click", () => showPhoto(currentPhotoIndex + 1));

            modalEl.addEventListener("keydown", (e) => {
                if (seriesButtons.length < 2) return;
                if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
                    e.preventDefault();
                    showPhoto(currentPhotoIndex + (e.key === "ArrowLeft" ? -1 : 1));
                }
            });

            // Open the modal with only the selected member's pictures.
            document.addEventListener("click", (e) => {
                const btn = e.target.closest(".rb-thumb");
                if (!btn) return;

                seriesButtons = Array.from(btn.closest(".masonry").querySelectorAll(".rb-thumb"));
                modalPrev.hidden = modalNext.hidden = seriesButtons.length < 2;
                showPhoto(seriesButtons.indexOf(btn));
                if (photoModal) photoModal.show();
            });
        </script>




        </body>

        </html>
