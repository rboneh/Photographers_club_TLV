<%- include('../partials/header') %>

    <!-- ===== Page ===== -->
    <div class="d-flex flex-column min-vh-100">

        <main class="flex-grow-1">
            <div class="container py-5">
                <% if (locals.member) { %>
                    <% /****** membersDB structure: const memberData={ key: memberKey, idPhoto: idPhoto, // 👈 הנתיב
                        המלא של תמונת ה-ID photos: memberPhotos, memberName: memberName, memberAbout: memberAbout };
                        ******* */ %>
                        <% const key=member.key; const name=member.memberName ?? key; const about=member.memberAbout
                            ?? "" ; const idPhoto=member.idPhoto ?? "public/pictures/img_avatar3.png" ; const
                            imgSrc=idPhoto; const memberPhotos=member.photos || [] ; %>



                            <h1 class="mb-4 text-center">
                                <%= name %>
                            </h1>

                            <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" dir="rtl">
                                <div class="carousel-inner container-l">

                                    <% memberPhotos.forEach((picture, index)=> { %>
                                        <div class="carousel-item rb-carousel-item <%= index === 0 ? 'active' : '' %>">
                                            <div class="d-flex justify-content-center">
                                                <img src="<%= picture %>" loading="lazy" alt="צילום של <%= name %>"  class="carousel-image">
                                            </div>
                                        </div>

                                        <% }) %>

                                </div>

                                <!-- Left and right controls/icons -->
                                <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel"
                                    data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel"
                                    data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>
                            </div>

                            <div class="d-flex justify-content-center mt-4">
                                <a href="/members" class="btn btn-outline-light">חזרה לחברים</a>
                            </div>

                            <% } else { %>

                                <p class="text-center">חבר לא נמצא.</p>
                                <% } %>
            </div>
        </main>

        <%- include('../partials/footer') %>

    </div>

    </body>

    </html>
