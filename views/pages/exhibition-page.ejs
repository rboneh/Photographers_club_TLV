<%- include('../partials/header') %>

    <!-- ===== Page ===== -->
    <div class="d-flex flex-column min-vh-100">

        <main class="flex-grow-1">
            <div class="container py-5">

                <% if (locals.exhibitionObj && locals.exhibitionKey) { %>
                    <% const exhibitionName=locals.exhibitionObj.exhibitionName; %>
                        <% const exhibitionAbout=locals.exhibitionObj.exhibitionAbout; %>
                            <% const exhibitionPhotosArr=locals.exhibitionObj.exhibitionPhotosArr; %>

                                <div class="d-flex flex-column justify-content-center mt-4">
                                    <h1 class="mb-4 text-center">מועדון צילום תל אביב</h1>
                                    <h2 class="mb-4 text-center">
                                        <%= exhibitionName %>
                                    </h2>
                                    <p class="h5 text-end mx-1">
                                        <%= exhibitionAbout %>
                                    </p>
                                </div>

                                <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" dir="rtl">
                                    <div class="carousel-inner container-l">

                                        <% exhibitionPhotosArr.forEach((exhibitionPhoto, index)=> {
                                            const imgSrc = exhibitionPhoto.picture ??
                                            "/public/pictures/img_avatar3.png";
                                            const memberName = exhibitionPhoto.name ?? "";
                                            const memberAbout = exhibitionPhoto.about ?? "";
                                            %>

                                            <div class="carousel-item rb-carousel-item <%= index === 0 ? 'active' : '' %>"
                                                data-member-name="<%= memberName %>"
                                                data-member-about="<%= memberAbout %>">
                                                <div class="d-flex justify-content-center pb-0">
                                                    <img src="<%= imgSrc %>" class="carousel-image pb-0" loading="lazy"
                                                        alt="צילום מאת <%= memberName %>">
                                                </div>
                                            </div>

                                            <% }) %>

                                    </div>

                                    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel"
                                        data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>

                                    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel"
                                        data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                </div>

                                <div id="memberInfo" class="d-flex flex-column justify-content-center mt-4 text-center">
                                    <h2 id="memberName" class="handwriting-hebrew"></h2>
                                    <p class="h5 text-end mx-1" id="memberAbout"></p>
                                </div>

                                <!-- ✅ JSON-LD schema (Google) -->
                                <script type="application/ld+json">
                                    <%- JSON.stringify({
                                    "@context": "https://schema.org",
                                    "@type": "ExhibitionEvent",
                                    name: exhibitionName,
                                    description: exhibitionAbout,
                                    organizer: { "@type": "Organization", name: "מועדון הצילום תל אביב" }
                                    }) %>
                                    </script>

                                <% } else { %>
                                    <h1 class="text-center">מועדון צילום תל אביב</h1>
                                    <h2 class="text-center">התערוכה לא נמצאה.</h2>
                                    <% } %>

            </div>
        </main>

        <%- include('../partials/footer') %>
    </div>

    <script>
        const carousel = document.getElementById("mainCarousel");
        const nameEl = document.getElementById("memberName");
        const aboutEl = document.getElementById("memberAbout");

        if (carousel && nameEl && aboutEl) {
            function updateMemberInfo(activeItem) {
                nameEl.textContent = activeItem?.dataset?.memberName || "";
                aboutEl.textContent = activeItem?.dataset?.memberAbout || "";
            }

            // initial load
            const firstActive = carousel.querySelector(".carousel-item.active");
            if (firstActive) updateMemberInfo(firstActive);

            // on slide change
            carousel.addEventListener("slid.bs.carousel", (event) => {
                updateMemberInfo(event.relatedTarget);
            });
        }
    </script>

    </body>

    </html>