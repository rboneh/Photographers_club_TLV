<%- include("../partials/header") %>

  <div class="d-flex flex-column min-vh-100">
    <div class="container-fluid bg-dark flex-grow-1 p-1">

      <h1 class="text-center mt-3 mb-3">מועדון הצילום תל אביב</h1>
      <h3 class="text-center handwriting-hebrew my-4">מקום מפגש לצלמים, ללימוד, העשרה, משוב ויצירה משותפת</h3>

      <% if (locals.membersPhotosArr4Carousel) { %>
        <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" dir="rtl">
          <div class="carousel-inner container-l">
            <% membersPhotosArr4Carousel.forEach((pictureObj, index)=> { %>
              <% const currentPic=pictureObj.picture %>
                <% const photographerName=pictureObj.name %>
                  <div class="carousel-item rb-carousel-item pb-0 pt-1 <%= index === 0 ? 'active' : '' %>">
                    <div class="d-flex justify-content-center">
                      <div class="main-carousel-frame">
                        <img src="<%= currentPic %>" alt="צילום מאת <%= photographerName %>" class="carousel-image" >
                        <h5 class="text-c m-0 mt-1 handwriting-hebrew">צלם/מת: <%= photographerName %>
                        </h5>
                      </div>
                    </div>

                  </div>

                  <% }) %>

          </div>

          <!-- Left and right controls/icons -->
          <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>

        <% } else { %>
          <% //console.log("EJS locals:", JSON.stringify(locals, null, 2)); %>
            <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel" dir="rtl">
              <!-- The slideshow/carousel -->
              <div class="carousel-inner container-l">
                <div class="carousel-item active rb-carousel-item">
                  <div class="d-flex justify-content-center">
                    <img src="/members/Moshe_Gross/5119 - Donna Rock, Maryland, Waitress - 25 Years.jpg"
                      alt="Moshe_Gross" class="carousel-image" loading="lazy">
                  </div>
                </div>
                <div class="carousel-item rb-carousel-item">
                  <div class="d-flex justify-content-center">
                    <img src="/members/Rahel_Rinat_Hilling/14.jpg" loading="lazy" alt="Rahel_Rinat_Hilling" class="carousel-image">
                  </div>
                </div>
                <div class="carousel-item rb-carousel-item">
                  <div class="d-flex justify-content-center">
                    <img src="/members/Ronen_Boneh/trix-200-tlv-22-2.jpg" loading="lazy" alt="Ronen_Boneh" class="carousel-image">
                  </div>
                </div>

              </div>

              <!-- Left and right controls/icons -->
              <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
              </button>
            </div>
            <% } %>
    </div>

    <%- include("../partials/footer") %>

  </div>

  </html>