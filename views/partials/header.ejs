<!DOCTYPE html>
<html lang="he">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!--meta bloc manage with helmet in index.ejs-->
  <!-- <meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    style-src 'self' https://fonts.googleapis.com 'unsafe-inline' https://cdn.jsdelivr.net;
    font-src 'self' https://fonts.gstatic.com data:;
    script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline' https://code.jquery.com;
    img-src 'self' https://picsum.photos https://fastly.picsum.photos data:;
  " /> -->


  <title>
    <%= locals.pageTitle || "מועדון הצילום תל אביב" %>
  </title>

  <meta name="description"
    content="<%= locals.pageDescription || 'מועדון צילום תל אביב – קהילה של צלמים, תערוכות, גלריות ופרויקטים אמנותיים' %>">

  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://photographers-club-tlv.onrender.com<%= (locals.canonicalPath || '') %>">

  <link rel="stylesheet" href="/styles/main.css" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />

  <!-- Preconnect for faster loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- DM Sans -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,100&display=swap" rel="stylesheet" />

  <!-- Playpen Sans Hebrew -->
  <link href="https://fonts.googleapis.com/css2?family=Playpen+Sans+Hebrew:wght@100..800&display=swap" rel="stylesheet">

  <!-- For SAO when running at fly.io -->
  <link rel="canonical" href="<%= baseUrl %><%= canonicalPath %>">

  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= locals.pageTitle || 'מועדון הצילום תל אביב' %>">
  <meta property="og:description" content="<%= locals.pageDescription || '' %>">
  <meta property="og:url" content="<%= baseUrl %><%= canonicalPath %>">

</head>

<body class="m-0 bg-dark text-white">
  <!-- --- NavBar --- -->
  <nav class="navbar sticky-top navbar-expand-lg bg-body-tertiary bg-dark border-bottom border-body myNavBar"
    data-bs-theme="dark" dir="rtl">
    <div class="container-fluid">
      <form id="brandForm" action="/" method="GET" class="navbar-brand bg-dark">
        <button class="navbar-brand bg-dark border-0" type="submit" aria-current="page">
          <img src="/pictures/logo_photographers_club_tlv.jpg" alt="Club Logo" style="width:40px" class="rounded-2">
          מועדון צילום תל אביב
        </button>
      </form>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <form id="homeForm" action="/home" method="GET">
              <button class="nav-link" type="submit" aria-current="page">
                בית
              </button>
            </form>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">אודות</a>
          </li>
          <li class="nav-item">
            <form id="membersNav" action="/members" method="GET">
              <button class="nav-link" href="/members">
                חברים
              </button>
            </form>
          </li>
          <li class="nav-item dropdown">

            <% if (!locals.exhibitionsList || locals.exhibitionsList.length===0) { %>

              <!-- Disabled when empty -->
              <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">
                תכרוכות וסופי שנה </a>

              <% } else { %>

                <!-- Dropdown when there are exhibitions -->
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                  aria-expanded="false">
                  תערוכות וסופי שנה </a>

                <ul class="dropdown-menu">

                  <% exhibitionsList.forEach(ex=> { %>
                    <li>
                      <form action="/exhibitions" method="GET">
                        <input type="hidden" name="exhibition" value="<%= ex %>">
                        <button class="dropdown-item" type="submit">
                          <%= ex %>
                        </button>
                      </form>
                    </li>
                    <% }) %>

                </ul>

                <% } %>

          </li>
        </ul>
      </div>
    </div>
  </nav>